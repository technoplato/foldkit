{
  "name": "books-cli-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "foldkit-books": "./dist/entry.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "books": "node dist/entry.js",
    "prebuild": "pnpm --filter books-core-example build",
    "pretypecheck": "pnpm --filter books-core-example build",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "books-core-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
