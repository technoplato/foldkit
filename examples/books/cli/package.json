{
  "name": "books-cli-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "books": "./dist/entry.js",
    "books-tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "books": "../scripts/books",
    "books-tui": "../scripts/books tui",
    "install-command": "../scripts/install-books-command",
    "login": "../scripts/books login",
    "prebuild": "pnpm --filter books-core-example build",
    "pretypecheck": "pnpm --filter books-core-example build",
    "pretest": "pnpm --filter books-core-example build",
    "start": "pnpm run build && pnpm run books",
    "test": "vitest run",
    "tui": "pnpm run build && pnpm run books-tui",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "books-core-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "transcript-player-core-example": "workspace:*",
    "foldkit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
