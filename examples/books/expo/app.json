{
  "expo": {
    "name": "Foldkit - Books",
    "slug": "foldkit-books",
    "scheme": "foldkit-books",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@foldkit/react-native/plugin/sceneLifecycle.cjs",
      "@foldkit/react-native/plugin/schedulerGuard.cjs"
    ],
    "ios": {
      "bundleIdentifier": "com.knophy.foldkit.books.dev",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.knophy.foldkit.books.dev"
    }
  }
}
