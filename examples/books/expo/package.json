{
  "name": "books-expo-example",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "ios": "expo start --ios --port 8097",
    "prepare-cores": "pnpm --filter @foldkit/react build && pnpm --filter @foldkit/react-native build && pnpm --filter transcript-player-core-example build && pnpm --filter read-aloud-core-example build && pnpm --filter books-core-example build",
    "prestart": "pnpm run prepare-cores && pnpm run voice",
    "prestart:made-up": "pnpm run prepare-cores && pnpm run voice",
    "prestart:signed-in": "pnpm run prepare-cores && pnpm run voice",
    "pretest": "pnpm run prepare-cores",
    "pretypecheck": "pnpm run prepare-cores",
    "routes": "node ../../../packages/react-native/bin/foldkit-expo-routes.mjs generate --navigation books-core-example#SyncedBooks",
    "routes:check": "node ../../../packages/react-native/bin/foldkit-expo-routes.mjs check --navigation books-core-example#SyncedBooks",
    "start": "expo start --port 8097",
    "start:made-up": "EXPO_PUBLIC_BOOKS_MADE_UP=1 expo start --port 8097",
    "start:signed-in": "./scripts/with-books-app expo start --port 8097 --dev-client",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "voice": "node scripts/make-made-up-voice.mjs",
    "start:made-up-shared": "EXPO_PUBLIC_BOOKS_MADE_UP=shared expo start --port 8097"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@foldkit/instant": "workspace:*",
    "@foldkit/react-native": "workspace:*",
    "@instantdb/core": "1.0.65",
    "@instantdb/react-native": "1.0.65",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "books-core-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "expo": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "foldkit": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "read-aloud-core-example": "workspace:*",
    "transcript-player-core-example": "workspace:*",
    "transcript-player-expo-example": "workspace:*"
  },
  "devDependencies": {
    "@babel/plugin-transform-object-rest-spread": "^7.29.7",
    "@types/react": "^19.2.17",
    "babel-preset-expo": "~57.0.4",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "@expo/ui"
        ]
      }
    }
  }
}
