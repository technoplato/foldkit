{
  "name": "counters-react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "./scripts/with-public-instant-env vite",
    "prebuild": "pnpm --filter counters-react-bindings-example build && pnpm --filter counters-instant-example build",
    "predev": "pnpm --filter counters-react-bindings-example build && pnpm --filter counters-instant-example build",
    "pretest": "pnpm --filter counters-react-bindings-example build",
    "pretypecheck": "pnpm --filter counters-react-bindings-example build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foldkit/instant": "workspace:*",
    "@tanstack/react-router": "^1.170.32",
    "counters-core-example": "workspace:*",
    "counters-instant-example": "workspace:*",
    "counters-react-bindings-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
