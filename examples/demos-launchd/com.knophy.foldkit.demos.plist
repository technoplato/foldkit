<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.knophy.foldkit.demos</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/foldkit-demos-launchd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/foldkit/demos-supervisor.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/foldkit/demos-supervisor.out.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>__HOME__/Development/foldkit</string>
</dict>
</plist>
