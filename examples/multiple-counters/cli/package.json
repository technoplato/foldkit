{
  "name": "multiple-counters-cli-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "counters": "./dist/entry.js",
    "counters-tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "counters": "../../counter/scripts/with-counter-v01-env node dist/entry.js",
    "counters-tui": "../../counter/scripts/with-counter-v01-env node dist/tui.js",
    "prebuild": "pnpm --filter multiple-counters-core-example build",
    "pretypecheck": "pnpm --filter multiple-counters-core-example build",
    "start": "pnpm run build && pnpm run counters",
    "test": "vitest run",
    "tui": "pnpm run build && pnpm run counters-tui",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter multiple-counters-core-example build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "multiple-counters-core-example": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
