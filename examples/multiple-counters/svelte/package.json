{
  "name": "multiple-counters-svelte-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5219 --strictPort",
    "predev": "pnpm --filter @foldkit/svelte build && pnpm --filter multiple-counters-core-example build",
    "pretest": "pnpm --filter @foldkit/svelte build && pnpm --filter multiple-counters-core-example build",
    "pretypecheck": "pnpm --filter @foldkit/svelte build && pnpm --filter multiple-counters-core-example build",
    "start": "pnpm run dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foldkit/svelte": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "multiple-counters-core-example": "workspace:*",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
