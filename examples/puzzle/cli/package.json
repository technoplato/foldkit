{
  "name": "puzzle-cli-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "puzzle": "./dist/entry.js",
    "puzzle-screen": "./dist/screenEntry.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "puzzle": "./scripts/run.sh",
    "puzzle-screen": "node dist/screenEntry.js",
    "puzzle:instant": "../scripts/with-puzzle-v01-env env PUZZLE_TAPE=instant ./scripts/run.sh",
    "count": "../scripts/with-puzzle-v01-env env PUZZLE_TAPE=instant ./scripts/run.sh show",
    "yes": "../scripts/with-puzzle-v01-env env PUZZLE_TAPE=instant ./scripts/run.sh do yes",
    "prebuild": "pnpm --filter puzzle-core-example build",
    "pretypecheck": "pnpm --filter puzzle-core-example build",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "puzzle-core-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
