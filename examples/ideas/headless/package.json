{
  "name": "ideas-headless-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "foldkit-ideas-headless": "./dist/entry.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ideas-headless": "node dist/entry.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "pnpm --filter ideas-core-example build",
    "pretypecheck": "pnpm --filter ideas-core-example build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "@instantdb/core": "1.0.53",
    "ideas-core-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
