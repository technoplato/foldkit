{
  "name": "ideas-book-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "./scripts/with-ideas-instant-env ./scripts/with-public-instant-env vite build",
    "dev": "./scripts/with-ideas-instant-env ./scripts/with-public-instant-env vite --port 5185",
    "typecheck": "tsc --noEmit",
    "preview": "./scripts/with-ideas-instant-env ./scripts/with-public-instant-env vite preview --host 127.0.0.1 --port 5204 --strictPort",
    "prebuild": "pnpm --filter ideas-core-example build",
    "predev": "pnpm --filter ideas-core-example build",
    "pretypecheck": "pnpm --filter ideas-core-example build"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.97",
    "@foldkit/devtools": "workspace:*",
    "@foldkit/instant": "workspace:*",
    "@foldkit/ui": "workspace:*",
    "@instantdb/core": "1.0.53",
    "@tailwindcss/vite": "^4.3.1",
    "ideas-core-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "workspace:*",
    "@instantdb/admin": "1.0.53",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "@types/node": "^25.9.3"
  }
