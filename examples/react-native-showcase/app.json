{
  "expo": {
    "name": "Foldkit Showcase",
    "slug": "foldkit-showcase",
    "scheme": "foldkit",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.knophy.foldkit.showcase.dev"
