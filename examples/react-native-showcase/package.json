{
  "name": "react-native-showcase-example",
  "private": true,
  "version": "0.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "android": "expo start --android",
    "dev-client": "expo start --dev-client --lan",
    "dev-client:android": "expo start --dev-client --lan --android",
    "dev-client:ios": "expo start --dev-client --lan --ios",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "export:web": "expo export --platform web",
    "go": "expo start --go --lan",
    "go:android": "expo start --go --lan --android",
    "go:ios": "expo start --go --lan --ios",
    "ios": "expo start --ios",
    "preandroid": "pnpm run prepare-examples",
    "predev-client": "pnpm run prepare-examples",
    "predev-client:android": "pnpm run prepare-examples",
    "predev-client:ios": "pnpm run prepare-examples",
    "preexport:android": "pnpm run prepare-examples",
    "preexport:ios": "pnpm run prepare-examples",
    "preexport:web": "pnpm run prepare-examples",
    "prego": "pnpm run prepare-examples",
    "prego:android": "pnpm run prepare-examples",
    "prego:ios": "pnpm run prepare-examples",
    "preios": "pnpm run prepare-examples",
    "prerun:android": "pnpm run prepare-examples",
    "prerun:ios": "pnpm run prepare-examples",
    "prestart": "pnpm run prepare-examples",
    "pretypecheck": "pnpm run prepare-examples",
    "prepare-examples": "pnpm --filter showcase-react-bindings-example build && pnpm --filter cardboard-react-bindings-example build && pnpm --filter counter-react-bindings-example build && pnpm --filter calculator-react-bindings-example build && pnpm --filter counters-react-bindings-example build && pnpm --filter fact-http-client-example build && pnpm --filter fact-react-bindings-example build && pnpm --filter wallet-live-client-example build && pnpm --filter wallet-local-vault-example build && pnpm --filter wallet-web-client-example build && pnpm --filter wallet-react-bindings-example build && pnpm --filter wallet-qr-example build",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "start": "expo start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "calculator-core-example": "workspace:*",
    "calculator-react-bindings-example": "workspace:*",
    "cardboard-core-example": "workspace:*",
    "cardboard-react-bindings-example": "workspace:*",
    "counter-core-example": "workspace:*",
    "counter-react-bindings-example": "workspace:*",
    "counters-core-example": "workspace:*",
    "counters-react-bindings-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "expo": "~57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "fact-core-example": "workspace:*",
    "fact-http-client-example": "workspace:*",
    "fact-react-bindings-example": "workspace:*",
    "foldkit": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "shared-react-bindings-example": "workspace:*",
    "showcase-core-example": "workspace:*",
    "showcase-react-bindings-example": "workspace:*",
    "wallet-core-example": "workspace:*",
    "wallet-live-client-example": "workspace:*",
    "wallet-local-vault-example": "workspace:*",
    "wallet-qr-example": "workspace:*",
    "wallet-react-bindings-example": "workspace:*",
    "wallet-web-client-example": "workspace:*"
  },
  "devDependencies": {
    "@babel/plugin-transform-object-rest-spread": "^7.29.7",
    "@types/react": "^19.2.17",
    "babel-preset-expo": "~57.0.4",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
