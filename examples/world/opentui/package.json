{
  "name": "world-opentui-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "foldkit-world-opentui": "./dist/entry.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prebuild": "pnpm --filter world-core-example build",
    "pretypecheck": "pnpm --filter world-core-example build",
    "start": "node dist/entry.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "wallet-simulated-client-example": "workspace:*",
    "world-core-example": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
