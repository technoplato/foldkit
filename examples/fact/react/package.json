{
  "name": "fact-react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "prebuild": "pnpm --filter fact-http-client-example build && pnpm --filter fact-react-bindings-example build",
    "predev": "pnpm --filter fact-http-client-example build && pnpm --filter fact-react-bindings-example build",
    "pretypecheck": "pnpm --filter fact-http-client-example build && pnpm --filter fact-react-bindings-example build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "fact-core-example": "workspace:*",
    "fact-http-client-example": "workspace:*",
    "fact-react-bindings-example": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shared-react-bindings-example": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
