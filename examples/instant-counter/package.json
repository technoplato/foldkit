{
  "name": "instant-counter-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preacceptance:live": "pnpm --filter @foldkit/instant build && pnpm --filter counter-core-example build",
    "acceptance:live": "tsx src/acceptance/liveAcceptance.ts",
    "prebuild": "pnpm --filter counter-core-example build",
    "build": "./scripts/with-public-instant-env vite build",
    "predev": "pnpm --filter counter-core-example build",
    "dev": "./scripts/with-public-instant-env vite",
    "preheadless": "pnpm --filter counter-core-example build",
    "headless": "tsx src/headless/entry.ts",
    "instant:perms": "npx instant-cli@1.0.53 push perms --yes --package core",
    "instant:schema": "npx instant-cli@1.0.53 push schema --yes --package core",
    "preview": "./scripts/with-public-instant-env vite preview --host localhost --port 5173 --strictPort",
    "pretest": "pnpm --filter counter-core-example build",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter counter-core-example build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foldkit/instant": "workspace:*",
    "@instantdb/admin": "1.0.53",
    "@instantdb/core": "1.0.53",
    "counter-core-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "workspace:*",
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "playwright": "^1.61.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
