{
  "expo": {
    "name": "Foldkit Instant Counter",
    "slug": "foldkit-instant-counter",
    "scheme": "foldkit-instant-counter",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.knophy.foldkit.instantcounter.dev",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.knophy.foldkit.instantcounter.dev",
      "usesCleartextTraffic": true
    },
    "plugins": ["expo-dev-client"]
  }
}
