{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "./dist"
  },
  "include": [
    "instant.schema.ts",
    "src/domain/**/*.ts",
    "src/processorClient/**/*.ts",
    "src/shared/identity.ts",
    "src/shared/presence.ts",
    "src/shared/sessionClaim.ts",
    "src/transport/**/*.ts",
    "src/v3Demo/client/**/*.ts",
    "src/v3Demo/shared/**/*.ts",
    "src/v3Demo/headless/enrollmentMaterializer.ts",
    "src/v3Demo/headless/messageProtocol.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
