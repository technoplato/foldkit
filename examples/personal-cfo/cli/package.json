{
  "name": "personal-cfo-cli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "cfo": "./dist/entry.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "cfo": "./scripts/run.sh",
    "clean": "rimraf dist",
    "prebuild": "pnpm --filter personal-cfo-core build",
    "pretypecheck": "pnpm --filter personal-cfo-core build",
    "prove": "./scripts/with-instant-env ./scripts/run.sh prove",
    "prove:memory": "env PERSONAL_CFO_LEDGER=memory ./scripts/run.sh prove",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "@instantdb/admin": "1.0.65",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "personal-cfo-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
