{
  "name": "read-aloud-react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "../../books/scripts/with-books-env vite --port 5184 --strictPort",
    "prebuild": "pnpm --filter @foldkit/react build && pnpm --filter read-aloud-core-example build && pnpm --filter read-aloud-react-bindings-example build",
    "predev": "pnpm --filter @foldkit/react build && pnpm --filter read-aloud-core-example build && pnpm --filter read-aloud-react-bindings-example build",
    "start": "pnpm run dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foldkit/instant": "workspace:*",
    "@foldkit/react": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "read-aloud-core-example": "workspace:*",
    "read-aloud-react-bindings-example": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
