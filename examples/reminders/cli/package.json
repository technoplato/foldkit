{
  "name": "reminders-cli-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "reminders": "./dist/entry.js",
    "reminders-tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "reminders": "../scripts/with-reminders-access node dist/entry.js",
    "reminders-tui": "../scripts/with-reminders-access node dist/tui.js",
    "login": "cloudflared access login https://reminders.knophy.com",
    "prebuild": "pnpm --filter reminders-core-example build",
    "pretypecheck": "pnpm --filter reminders-core-example build",
    "pretest": "pnpm --filter reminders-core-example build",
    "start": "pnpm run build && pnpm run reminders",
    "test": "vitest run",
    "tui": "pnpm run build && pnpm run reminders-tui",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "reminders-core-example": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
