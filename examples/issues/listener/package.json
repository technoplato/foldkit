{
  "name": "issues-listener-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "foldkit-issues-listener": "./dist/entry.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prebuild": "pnpm --filter @foldkit/instant-tools build",
    "pretest": "pnpm --filter @foldkit/instant-tools build",
    "pretypecheck": "pnpm --filter @foldkit/instant-tools build",
    "start": "node dist/entry.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foldkit/instant-tools": "workspace:*",
    "@instantdb/core": "1.0.53",
    "effect": "4.0.0-beta.97"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
