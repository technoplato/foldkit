{
  "name": "issues-cli-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "foldkit-issues": "./dist/entry.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "issues": "node dist/entry.js",
    "prebuild": "pnpm --filter issues-core-example build",
    "pretypecheck": "pnpm --filter issues-core-example build",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "@foldkit/instant-tools": "workspace:*",
    "@instantdb/admin": "1.0.53",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "issues-core-example": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
