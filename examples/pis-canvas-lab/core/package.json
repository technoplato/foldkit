{
  "name": "pis-canvas-lab-core-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "pretypecheck": "pnpm --filter counter-core-example build && pnpm --filter counters-core-example build && pnpm --filter calculator-core-example build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter counter-core-example build && pnpm --filter counters-core-example build && pnpm --filter calculator-core-example build",
    "test": "vitest run"
  },
  "dependencies": {
    "calculator-core-example": "workspace:*",
    "counter-core-example": "workspace:*",
    "counters-core-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
