{
  "name": "wallet-react-bindings-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prebuild": "pnpm --filter wallet-core-example build && pnpm --filter wallet-simulated-client-example build && pnpm --filter shared-react-bindings-example build",
    "pretest": "pnpm run build",
    "pretypecheck": "pnpm --filter wallet-core-example build && pnpm --filter wallet-simulated-client-example build && pnpm --filter shared-react-bindings-example build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "shared-react-bindings-example": "workspace:*",
    "wallet-core-example": "workspace:*",
    "wallet-simulated-client-example": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.2.3 <20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.4",
    "prettier": "^3.8.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
