{
  "name": "wallet-terminal-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/host.js",
  "module": "./dist/host.js",
  "types": "./dist/host.d.ts",
  "bin": {
    "foldkit-wallet-terminal": "./dist/entry.js"
  },
  "exports": {
    ".": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prebuild": "pnpm --filter wallet-core-example build && pnpm --filter wallet-simulated-client-example build",
    "pretest": "pnpm --filter wallet-cli-example build && pnpm --filter wallet-tui-example build",
    "pretypecheck": "pnpm --filter wallet-core-example build && pnpm --filter wallet-simulated-client-example build && pnpm --filter wallet-cli-example build && pnpm --filter wallet-tui-example build",
    "terminal": "node dist/entry.js",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "wallet-core-example": "workspace:*",
    "wallet-simulated-client-example": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wallet-cli-example": "workspace:*",
    "wallet-tui-example": "workspace:*"
  }
}
