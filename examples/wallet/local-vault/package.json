{
  "name": "wallet-local-vault-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prebuild": "pnpm --filter wallet-core-example build",
    "pretest": "pnpm --filter wallet-core-example build",
    "pretypecheck": "pnpm --filter wallet-core-example build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mysten/sui": "2.22.1",
    "@noble/curves": "1.9.1",
    "@scure/base": "1.2.6",
    "@scure/btc-signer": "2.2.0",
    "@solana/addresses": "7.0.0",
    "effect": "4.0.0-beta.97",
    "viem": "2.55.10",
    "wallet-core-example": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
