{
  "name": "wallet-testnet-server-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-with-provenance.mjs",
    "clean": "rimraf dist",
    "dev": "tsx src/entry.ts",
    "prebuild": "pnpm --filter wallet-core-example build && pnpm --filter wallet-remote-example build && pnpm --filter wallet-testnet-node-example build",
    "predev": "pnpm run prebuild",
    "pretest": "pnpm run prebuild",
    "pretypecheck": "pnpm run prebuild",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "effect": "4.0.0-beta.97",
    "viem": "2.55.10",
    "wallet-core-example": "workspace:*",
    "wallet-remote-example": "workspace:*",
    "wallet-testnet-node-example": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
