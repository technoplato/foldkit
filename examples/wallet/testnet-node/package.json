{
  "name": "wallet-testnet-node-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prebuild": "pnpm --filter wallet-local-vault-example build",
    "pretest": "pnpm --filter wallet-local-vault-example build",
    "pretypecheck": "pnpm --filter wallet-local-vault-example build",
    "test": "vitest run",
    "test:live:ethereum-transfer": "WALLET_ETHEREUM_SEPOLIA_LIVE_TRANSFER=1 vitest run src/live.transfer.test.ts",
    "test:live:solana-transfer": "WALLET_SOLANA_DEVNET_LIVE_TRANSFER=1 vitest run src/live.transfer.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@solana-program/system": "0.13.0",
    "@solana-program/token": "0.15.0",
    "@solana/kit": "7.0.0",
    "effect": "4.0.0-beta.97",
    "viem": "2.55.10",
    "wallet-core-example": "workspace:*",
    "wallet-local-vault-example": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
