{
  "name": "replayability-react-bindings-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prebuild": "pnpm --filter replayability-core-example build && pnpm --filter shared-react-bindings-example build",
    "pretypecheck": "pnpm --filter replayability-core-example build && pnpm --filter shared-react-bindings-example build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "4.0.0-beta.97",
    "fact-core-example": "workspace:*",
    "foldkit": "workspace:*",
    "react": "19.2.3",
    "replayability-core-example": "workspace:*",
    "shared-react-bindings-example": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
