{
  "name": "counter-expo-router-example",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "android": "../scripts/with-counter-v01-env ../expo/scripts/with-public-instant-env expo start --android --port 8090",
    "ios": "../scripts/with-counter-v01-env ../expo/scripts/with-public-instant-env expo start --ios --port 8090",
    "pretest": "pnpm --filter @foldkit/react build && pnpm --filter @foldkit/react-native build && pnpm --filter counter-core-example build",
    "pretypecheck": "pnpm --filter @foldkit/react build && pnpm --filter @foldkit/react-native build && pnpm --filter counter-core-example build",
    "start": "../scripts/with-counter-v01-env ../expo/scripts/with-public-instant-env expo start --port 8090",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@foldkit/react-native": "workspace:*",
    "counter-expo-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "foldkit": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-object-rest-spread": "^7.29.7",
    "@types/react": "^19.2.17",
    "babel-preset-expo": "~57.0.4",
    "prettier": "^3.8.4",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
