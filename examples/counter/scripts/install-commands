#!/bin/sh
# Puts `counter` and `counters` on your PATH: launchers in ~/.local/bin,
# or in COUNTER_BIN_DIR, that run the Counter's and the Multiple Counters'
# terminals from this checkout. It builds both first; COUNTER_SKIP_BUILD=1
# skips that.
#
#   examples/counter/scripts/install-commands
#   counter
#   counters
set -eu

here="$(cd "$(dirname "$0")" && pwd -P)"
repo="$(cd "$here/../../.." && pwd -P)"
counters="$(cd "$here/../../multiple-counters/scripts" && pwd -P)"
bin_dir="${COUNTER_BIN_DIR:-$HOME/.local/bin}"

chmod +x "$here/counter" "$counters/counters"

if [ "${COUNTER_SKIP_BUILD:-}" != "1" ]; then
  echo "Building the counter and counters commands in ${repo}…"
  (cd "$repo" && pnpm_config_verify_deps_before_run=false pnpm --filter 'counter-cli-example...' --filter 'multiple-counters-cli-example...' run build)
fi

mkdir -p "$bin_dir"

cat > "$bin_dir/counter" <<EOF
#!/bin/sh
# The Counter's terminal from $repo.
# Reinstall with $here/install-commands
exec "$here/counter" "\$@"
EOF
chmod +x "$bin_dir/counter"

cat > "$bin_dir/counters" <<EOF
#!/bin/sh
# The Multiple Counters' terminal from $repo.
# Reinstall with $here/install-commands
exec "$counters/counters" "\$@"
EOF
chmod +x "$bin_dir/counters"

echo "Installed $bin_dir/counter and $bin_dir/counters"

case "$repo" in
  */.claude/worktrees/* | */.t3/worktrees/*)
    echo "Note: $repo is a temporary worktree. Run this from a checkout you keep, so the commands go on working after it goes."
    ;;
esac

case ":$PATH:" in
  *":$bin_dir:"*) echo "Try: counter" ;;
  *) echo "Add $bin_dir to your PATH, then try: counter" ;;
esac
