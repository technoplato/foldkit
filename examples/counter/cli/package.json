{
  "name": "counter-cli-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "counter": "./dist/entry.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "counter": "./scripts/run.sh",
    "counter:instant": "../scripts/with-counter-v01-env env COUNTER_TAPE=instant ./scripts/run.sh",
    "count": "../scripts/with-counter-v01-env env COUNTER_TAPE=instant ./scripts/run.sh show",
    "increment": "../scripts/with-counter-v01-env env COUNTER_TAPE=instant ./scripts/run.sh do increment",
    "prebuild": "pnpm --filter counter-core-example build && pnpm --filter counter-instant-example build",
    "pretypecheck": "pnpm --filter counter-core-example build && pnpm --filter counter-instant-example build",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.97",
    "@foldkit/instant": "workspace:*",
    "counter-core-example": "workspace:*",
    "counter-instant-example": "workspace:*",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
