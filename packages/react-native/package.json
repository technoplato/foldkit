{
  "name": "@foldkit/react-native",
  "version": "0.0.0",
  "description": "React Native host components for Foldkit Programs",
  "type": "module",
  "exports": {
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "import": "./dist/interaction/index.js"
    },
    "./react-navigation": {
      "types": "./dist/reactNavigation/index.d.ts",
      "import": "./dist/reactNavigation/index.js"
    },
    "./expo-router": {
      "types": "./dist/expoRouter/index.d.ts",
      "import": "./dist/expoRouter/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && tsc -b tsconfig.build.json",
    "watch": "tsc -b tsconfig.build.json --watch",
    "lint": "pnpm --filter @foldkit/oxlint-plugin build && oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@foldkit/react": "workspace:^0"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=7.3.14 <8",
    "@react-navigation/native-stack": ">=7.18.6 <8",
    "effect": "4.0.0-beta.97",
    "expo-router": ">=57.0.24 <58",
    "foldkit": "workspace:^0",
    "react": ">=19.2.3 <20",
    "react-native": ">=0.86.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    },
    "@react-navigation/native-stack": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@types/react": "^19.2.17",
    "effect": "4.0.0-beta.97",
    "expo-router": "~57.0.24",
    "foldkit": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "foldkit",
    "react-native",
    "expo",
    "host"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
