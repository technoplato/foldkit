{
  "name": "@foldkit/react-native",
  "version": "0.0.0",
  "description": "React Native host components for Foldkit Programs",
  "type": "module",
  "exports": {
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "import": "./dist/interaction/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && tsc -b tsconfig.build.json",
    "watch": "tsc -b tsconfig.build.json --watch",
    "lint": "pnpm --filter @foldkit/oxlint-plugin build && oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@foldkit/react": "workspace:^0"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:^0",
    "react": ">=19.2.3 <20",
    "react-native": ">=0.86.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "foldkit",
    "react-native",
    "expo",
    "host"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
