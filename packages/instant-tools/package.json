{
  "name": "@foldkit/instant-tools",
  "version": "0.1.0",
  "description": "Transport-neutral structured logging and issue tracking for Effect applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./instant": {
      "types": "./dist/instant/index.d.ts",
      "import": "./dist/instant/index.js"
    },
    "./issues": {
      "types": "./dist/issues/index.d.ts",
      "import": "./dist/issues/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@instantdb/core": "1.0.53",
    "effect": "4.0.0-beta.97"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.97",
    "@instantdb/core": "1.0.53",
    "effect": "4.0.0-beta.97",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "effect",
    "instantdb",
    "issue-tracking",
    "logging"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/instant-tools"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  }
}
