{
  "name": "@foldkit/opentui",
  "version": "0.0.0",
  "description": "OpenTUI host for Foldkit Programs",
  "type": "module",
  "exports": {
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "import": "./dist/interaction/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && tsc -b tsconfig.build.json",
    "lint": "pnpm --filter @foldkit/oxlint-plugin build && oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src/"
  },
  "peerDependencies": {
    "@opentui/core": "^0.5.4",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:^0"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.4",
    "@types/bun": "^1.3.4",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "foldkit",
    "opentui",
    "terminal",
    "host"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/opentui"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
