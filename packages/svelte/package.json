{
  "name": "@foldkit/svelte",
  "version": "0.0.0",
  "description": "Svelte 5 host components for Foldkit Programs",
  "type": "module",
  "exports": {
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "svelte": "./dist/interaction/index.js",
      "import": "./dist/interaction/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "build": "pnpm run clean && tsc -b tsconfig.build.json && node scripts/copySvelteFiles.mjs",
    "lint": "pnpm --filter @foldkit/oxlint-plugin build && oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:^0",
    "svelte": "^5.38.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "rimraf": "^6.1.3",
    "svelte": "^5.38.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "foldkit",
    "svelte",
    "host"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
