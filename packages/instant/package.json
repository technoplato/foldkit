{
  "name": "@foldkit/instant",
  "version": "0.1.0",
  "description": "Offline-first InstantDB transport primitives for Foldkit Programs",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/browser.js",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./sharing": {
      "types": "./dist/sharing/tape.d.ts",
      "import": "./dist/sharing/tape.js",
      "default": "./dist/sharing/tape.js"
    },
    "./snapshot-log": {
      "types": "./dist/snapshotLog/index.d.ts",
      "import": "./dist/snapshotLog/index.js",
      "default": "./dist/snapshotLog/index.js"
    },
    "./hosted-identity/vite": {
      "types": "./dist/hostedIdentity/vite.d.ts",
      "import": "./dist/hostedIdentity/vite.js",
      "default": "./dist/hostedIdentity/vite.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist *.tsbuildinfo",
    "compile": "tsc -b tsconfig.build.json",
    "build": "pnpm run clean && pnpm run compile",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@instantdb/admin": "1.0.65",
    "@instantdb/core": "1.0.65",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:^0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@instantdb/admin": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.97",
    "@instantdb/admin": "1.0.65",
    "@instantdb/core": "1.0.65",
    "@types/node": "^25.9.3",
    "effect": "4.0.0-beta.97",
    "foldkit": "workspace:*",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "effect",
    "foldkit",
    "instantdb",
    "offline-first",
    "realtime"
  ],
  "author": "Devin Jameson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foldkit/foldkit.git",
    "directory": "packages/instant"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  }
}
